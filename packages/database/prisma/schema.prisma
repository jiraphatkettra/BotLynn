// ==========================================
// FANDAY COMMUNITY DATING SYSTEM
// ==========================================

enum FandayStatus {
  DRAFT
  REGISTRATION
  MATCHING
  ACTIVE
  LETTERS
  ENDED
  CANCELLED
  PAUSED
}

model FandayEvent {
  id                String       @id @default(cuid())
  guildId           String
  title             String       @default("กิจกรรมแฟนเดย์ • 753BC")
  status            FandayStatus @default(DRAFT)
  pairingMode       String       @default("MALE_FEMALE") // MALE_FEMALE, MALE_MALE, FEMALE_FEMALE, MIXED_ANY, CUSTOM_RULES
  minPlayers        Int          @default(7)
  maxPlayers        Int?
  registrationStart DateTime?
  registrationEnd   DateTime?
  eventStart        DateTime?
  eventEnd          DateTime?
  letterDeadline    DateTime?
  panelChannelId    String?
  panelMessageId    String?
  formId            String?
  allowSelfLock     Boolean      @default(true)
  allowReroll       Boolean      @default(true)
  rerollLimit       Int          @default(1)
  aiMatchingEnabled Boolean      @default(true)
  config            Json?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  forms             FandayForm[]
  players           FandayPlayer[]
  pairs             FandayPair[]
  letters           FandayLetter[]

  @@index([guildId])
  @@index([status])
  @@map("fanday_events")
}

model FandayForm {
  id        String       @id @default(cuid())
  eventId   String?
  event     FandayEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title     String       @default("แบบประเมินและนิสัยสำหรับจับคู่แฟนเดย์")
  questions Json         // Array of question schema objects
  version   Int          @default(1)
  isActive  Boolean      @default(true)

  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([eventId])
  @@map("fanday_forms")
}

model FandayPlayer {
  id           String      @id @default(cuid())
  eventId      String
  event        FandayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  discordId    String
  displayName  String
  gender       String      @default("PREFER_NOT") // MALE, FEMALE, NONBINARY, PREFER_NOT
  seeking      String      @default("ANY")        // MALE, FEMALE, ANY
  status       String      @default("REGISTERED") // REGISTERED, WAITLIST, MATCHED, LOCKED, WITHDRAWN, BANNED, NO_SHOW
  hasPartner   Boolean     @default(false)
  lockedWithId String?
  typeCode     String?
  typeSummary  String?
  answers      Json?
  rerollsUsed  Int         @default(0)

  joinedAt     DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@unique([eventId, discordId])
  @@index([eventId])
  @@index([discordId])
  @@index([status])
  @@map("fanday_players")
}

model FandayPair {
  id            String              @id @default(cuid())
  eventId       String
  event         FandayEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  playerAId     String
  playerBId     String
  source        String              @default("AI") // RANDOM, AI, SELF_LOCK, ADMIN_MANUAL
  compatibility Float?
  reason        String?
  status        String              @default("ACTIVE") // PENDING_CONFIRM, ACTIVE, DISSOLVED, COMPLETED
  channelId     String?
  lockedAt      DateTime?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  gameSessions  FandayGameSession[]
  letters       FandayLetter[]

  @@index([eventId])
  @@index([playerAId])
  @@index([playerBId])
  @@index([status])
  @@map("fanday_pairs")
}

model FandayGameSession {
  id        String     @id @default(cuid())
  pairId    String
  pair      FandayPair @relation(fields: [pairId], references: [id], onDelete: Cascade)
  gameKey   String
  state     Json
  status    String     @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, TIMEOUT
  score     Int?
  startedAt DateTime?
  endedAt   DateTime?

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([pairId])
  @@index([status])
  @@map("fanday_game_sessions")
}

model FandayLetter {
  id          String      @id @default(cuid())
  eventId     String
  event       FandayEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  pairId      String
  pair        FandayPair  @relation(fields: [pairId], references: [id], onDelete: Cascade)
  fromId      String
  toId        String
  content     String      @db.Text
  isAnonymous Boolean     @default(false)
  status      String      @default("DRAFT") // DRAFT, PENDING_REVIEW, SENT, DELIVERED, BLOCKED
  deliveredAt DateTime?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([eventId])
  @@index([pairId])
  @@index([fromId])
  @@index([toId])
  @@index([status])
  @@map("fanday_letters")
}

model FandayMatchLog {
  id        String   @id @default(cuid())
  eventId   String
  runAt     DateTime @default(now())
  mode      String
  seed      String
  snapshot  Json

  @@index([eventId])
  @@map("fanday_match_logs")
}

model FandayBlock {
  id        String   @id @default(cuid())
  eventId   String?
  blockerId String
  blockedId String

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@map("fanday_blocks")
}

model FandayJob {
  id        String   @id @default(cuid())
  type      String
  payload   Json
  runAt     DateTime
  status    String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  attempts  Int      @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, runAt])
  @@map("fanday_jobs")
}

model FandayOutbox {
  id              String   @id @default(cuid())
  targetDiscordId String
  channelId       String?
  content         String?
  embedData       Json?
  status          String   @default("PENDING") // PENDING, SENT, FAILED
  attempts        Int      @default(0)
  lastError       String?

  createdAt       DateTime @default(now())

  @@index([status])
  @@map("fanday_outbox")
}

